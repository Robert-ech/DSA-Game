# Copy to .env.local (gitignored) for local dev, and add the same two
# variables in Vercel: Project Settings -> Environment Variables.
# Both values come from Supabase: Project Settings -> API.
# The anon key is safe to expose in client code (RLS guards the data).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
